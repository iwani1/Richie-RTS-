diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000..cc130b9
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,20 @@
+version: 2
+updates:
+  - package-ecosystem: npm
+    directory: "/"
+    schedule:
+      interval: weekly
+    open-pull-requests-limit: 5
+    groups:
+      # One PR for the test toolchain, one for the rest, instead of a dozen.
+      test-tooling:
+        patterns: ["vitest", "@vitest/*", "jsdom", "@testing-library/*"]
+      build-tooling:
+        patterns: ["vite", "@vitejs/*", "typescript", "eslint*", "@eslint/*", "typescript-eslint"]
+    ignore:
+      - dependency-name: "*"
+        update-types: ["version-update:semver-patch"]
+  - package-ecosystem: github-actions
+    directory: "/"
+    schedule:
+      interval: weekly
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index d946413..11a8d55 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,19 +1,22 @@
 # Quality gates on every push and pull request.
 #
 # These are the same four gates the standing brief (AGENTS.md §14) requires before any
-# change, run in the same order as `npm run check`. Nothing here depends on a database,
-# a server or a secret: the application is a static single-file build in this phase.
-#
-# HONEST LIMIT: this file was authored in an environment with no git remote and no CI
-# runner, so its execution has NOT been observed. The gates it invokes have each been run
-# locally and pass. Treat the first green run on the real repository as the verification.
+# change, run in the same order as `npm run check`, plus a coverage ratchet and a full
+# dependency audit. Nothing here depends on a database, a server or a secret: the
+# application is a static single-file build in this phase.
 
 name: ci
 
 on:
   push:
+    branches: [main]
   pull_request:
 
+# Superseded runs on the same ref are cancelled; only the newest one matters.
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
 permissions:
   contents: read
 
@@ -23,10 +26,13 @@ jobs:
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+        with:
+          # The job never pushes; do not leave the token in .git/config.
+          persist-credentials: false
 
       - uses: actions/setup-node@v4
         with:
-          node-version: 20
+          node-version: 20.19
           cache: npm
 
       - name: Install (exact lockfile)
@@ -38,11 +44,27 @@ jobs:
       - name: Lint
         run: npm run lint
 
-      - name: Test
-        run: npm test
+      - name: Test with coverage thresholds
+        run: npm run test:coverage
 
       - name: Build
         run: npm run build
 
+      # Production dependencies gate the deployable artifact.
       - name: Audit production dependencies
         run: npm audit --omit=dev --audit-level=high
+
+      # Dev dependencies run on the runner and in every contributor's shell, so they are
+      # audited too. Today this fails until vitest/vite are upgraded (see audit M-01);
+      # remove continue-on-error once that upgrade lands.
+      - name: Audit all dependencies (informational until upgraded)
+        run: npm run audit:dev
+        continue-on-error: true
+
+      - name: Upload build artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: dist
+          path: dist/index.html
+          if-no-files-found: error
+          retention-days: 14
diff --git a/.github/workflows/codeql.yml b/.github/workflows/codeql.yml
new file mode 100644
index 0000000..a4287e6
--- /dev/null
+++ b/.github/workflows/codeql.yml
@@ -0,0 +1,26 @@
+name: codeql
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  schedule:
+    - cron: "0 3 * * 1"
+
+permissions:
+  contents: read
+  security-events: write
+
+jobs:
+  analyze:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: github/codeql-action/init@v3
+        with:
+          languages: javascript-typescript
+          queries: security-and-quality
+      - uses: github/codeql-action/analyze@v3
diff --git a/.github/workflows/dependency-review.yml b/.github/workflows/dependency-review.yml
new file mode 100644
index 0000000..33c132c
--- /dev/null
+++ b/.github/workflows/dependency-review.yml
@@ -0,0 +1,23 @@
+# Blocks a pull request that introduces a dependency with a known vulnerability or an
+# incompatible licence. Requires the repository's dependency graph (on by default).
+name: dependency-review
+
+on:
+  pull_request:
+
+permissions:
+  contents: read
+  pull-requests: write
+
+jobs:
+  review:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/dependency-review-action@v4
+        with:
+          fail-on-severity: high
+          # GPL/AGPL/SSPL are not in this dependency tree today and must not arrive.
+          deny-licenses: GPL-2.0, GPL-3.0, AGPL-3.0, SSPL-1.0
