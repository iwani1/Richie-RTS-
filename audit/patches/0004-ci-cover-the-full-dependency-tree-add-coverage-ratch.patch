diff --git a/vitest.config.ts b/vitest.config.ts
new file mode 100644
index 0000000..5d53c35
--- /dev/null
+++ b/vitest.config.ts
@@ -0,0 +1,15 @@
+import { defineConfig } from "vitest/config";
+
+// Coverage thresholds are a ratchet: they sit just under the levels the suite reaches today
+// (about 82% statements), so a change that drops coverage fails CI instead of passing quietly.
+export default defineConfig({
+  test: {
+    coverage: {
+      provider: "v8",
+      reporter: ["text", "json-summary", "lcov"],
+      include: ["src/**/*.{ts,tsx}"],
+      exclude: ["src/main.tsx", "src/**/*.test.{ts,tsx}"],
+      thresholds: { statements: 80, branches: 72, functions: 70, lines: 80 },
+    },
+  },
+});
