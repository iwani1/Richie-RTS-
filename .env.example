# Copy to .env and fill in. .env is git-ignored.
#
#   cp .env.example .env
#   openssl rand -base64 32        -> paste as SESSION_SECRET
#
# Never commit a real file: it contains the database password and the cookie-sealing key.

# PostgreSQL connection string. The user must be able to create databases, or the database must
# already exist and it must own it.
#
# The password here must be the same one the database was created with — if you started the
# container below, that is the POSTGRES_PASSWORD you passed to it. Editing this line never changes
# a password already stored in a running database.
DATABASE_URL="postgresql://richie:your-password@127.0.0.1:5432/richie_tms"

# Seals the session cookie (iron-session). At least 32 characters. Generate one per installation:
#   openssl rand -base64 32
# Changing it signs everybody out, which is exactly what you want if it has ever leaked.
SESSION_SECRET="change-me-before-first-start"

# Leave NODE_ENV out. `npm run dev` and `npm start` each set what they need, and setting it here
# only makes the two commands disagree with the file.
# NODE_ENV="production"

# Only behind a reverse proxy. Without it, X-Forwarded-For is ignored and the sign-in throttle keys
# on the account alone — a client can send that header, so trusting it directly would let anyone
# reset their own rate limit.
# TRUST_PROXY="1"

# The address staff actually use, when a proxy rewrites the Host header. Used by the cross-site
# check on state-changing requests.
# PUBLIC_ORIGIN="https://tms.example.com"

# Set to 1 only when TLS is terminated in front of the application. Adds HSTS.
# HTTPS="1"

# Integration tests (optional): npm run test:integration runs them against this database.
# TEST_DATABASE_URL="postgresql://richie:your-password@127.0.0.1:5432/richie_tms_test"
