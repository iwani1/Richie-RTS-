# Copy to .env and fill in — or let the tooling do it, which is easier and cannot produce a
# mismatched password:
#
#   npm run env:init        (writes .env with a generated database password and session secret)
#
# .env is git-ignored. If you copy this file by hand, remember that the password in DATABASE_URL
# and the value of POSTGRES_PASSWORD must be the same, and SESSION_SECRET must be 32+ characters.
#
# Never commit a real file: it contains the database password and the cookie-sealing key.

# PostgreSQL. The user and password here must match POSTGRES_USER / POSTGRES_PASSWORD in
# docker-compose.yml (or your own PostgreSQL installation).
DATABASE_URL="postgresql://richie:change-me-before-first-start@127.0.0.1:5433/richie_tms"

# Seals the session cookie (iron-session). At least 32 characters. Generate one per installation:
#   openssl rand -base64 32
# Changing it signs everybody out, which is exactly what you want if it has ever leaked.
SESSION_SECRET="replace-me-with-openssl-rand-base64-32"

# development | production. `npm run build && npm start` should run with production.
NODE_ENV="development"

# Password for the PostgreSQL container, read by docker-compose.yml.
POSTGRES_PASSWORD="change-me-before-first-start"

# Host port the database is published on. 5433 rather than 5432 because Fedora workstations
# often already have a PostgreSQL (or a stale Podman port forwarder) on 5432. If you change it,
# change the port in DATABASE_URL above to match.
POSTGRES_PORT="5433"

# ---------------------------------------------------------------------------------------------
# Demo data (optional, never for production)
# ---------------------------------------------------------------------------------------------
# `npm run db:seed` refuses unless this is true, refuses when NODE_ENV=production, and refuses
# unless a demo password is supplied. There is no default password in the repository.
ALLOW_DEMO_SEED="false"
DEMO_ADMIN_EMAIL="admin@richie.test"
DEMO_ADMIN_PASSWORD=""
